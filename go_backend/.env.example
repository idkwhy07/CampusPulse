# PostgreSQL
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/postgres?sslmode=disable

# Auth
JWT_SECRET=replace-with-a-long-random-secret
PORT=8080

# Report Type/Description compatibility model (:8002)
CAMPUSPULSE_ML_ENABLED=true
CAMPUSPULSE_ML_API_URL=http://127.0.0.1:8002
CAMPUSPULSE_ML_TIMEOUT=3s

# Student document RAG (:8003)
CAMPUSPULSE_STUDENT_AI_URL=http://127.0.0.1:8003

# Admin live PostgreSQL RAG (:8001)
CAMPUSPULSE_ADMIN_AI_URL=http://127.0.0.1:8001
CAMPUSPULSE_ADMIN_AI_KEY=replace-with-a-long-random-internal-key

# Timeout for both chatbot services
CAMPUSPULSE_CHAT_TIMEOUT=60s
