# demo: chạy localhost với dữ liệu giả
# internal: bắt buộc INTERNAL_API_KEY; Go kiểm tra JWT/STAFF trước khi gọi.
APP_MODE=demo
INTERNAL_API_KEY=your_internal_api_key_here
DATA_MODE=mock
REPORTS_PATH=data/rag_knowledge.csv

# AI_MODE: 'cloud' (dùng Gemini + DeepSeek) hoặc 'offline' (dùng quy tắc/từ khóa)
AI_MODE=cloud

# false: AI lỗi (hết quota, JSON sai...) thì lùi về quy tắc/từ khóa và hiện cảnh báo.
# true: báo lỗi 503 nếu AI không chạy, không dùng fallback.
AI_REQUIRED=false

# Khóa API Cloud AI. KHÔNG commit file .env thật chứa key này.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
GEMINI_API_KEY=your-gemini-key-here

# Tên mô hình AI Cloud
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=deepseek-chat

AI_TIMEOUT=60
SEMANTIC_MIN_SCORE=0.35