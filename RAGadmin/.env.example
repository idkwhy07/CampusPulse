# Admin RAG: Go backend checks JWT/STAFF before proxying requests here.
APP_MODE=internal
INTERNAL_API_KEY=replace-with-the-same-long-key-as-CAMPUSPULSE_ADMIN_AI_KEY

# Read live CampusPulse reports/incidents directly from PostgreSQL/Supabase.
DATA_MODE=postgres
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/postgres?sslmode=disable

# Cloud AI: Gemini embedding + DeepSeek reasoning/generation.
AI_MODE=cloud
AI_REQUIRED=false
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
GEMINI_API_KEY=your-gemini-key-here
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=deepseek-chat
AI_TIMEOUT=60
SEMANTIC_MIN_SCORE=0.35
